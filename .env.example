# ==========================================
# Hotel Gemini - Environment Configuration
# ==========================================

# Service Listening Port (Default: 8088)
PORT=8088

# JWT Secret Key (Production: Generate a high-entropy random string, e.g. openssl rand -hex 32)
JWT_SECRET=hotel_gemini_production_jwt_key_2026_change_me

# Default Boss Administrator Account
BOSS_USERNAME=boss
BOSS_PASSWORD=boss12345
BOSS_NAME=酒店老板

# Database Storage Path (Default: ./hotel.db, Docker: /app/data/hotel.db)
# DB_PATH=./data/hotel.db
